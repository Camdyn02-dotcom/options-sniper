@app.callback(
    Output("manual-score-output", "children"),
    Input("score-button", "n_clicks"),
    State("manual-ticker", "value")
)
def manual_score(n_clicks, ticker):
    if n_clicks > 0 and ticker:
        try:
            stock = yf.Ticker(ticker.upper())
            hist = stock.history(period="6mo")
            last_price = hist["Close"].iloc[-1]
            score = 0
            if hist["Close"].iloc[-1] > hist["Close"].rolling(50).mean().iloc[-1]:
                score += 3
            if hist["Close"].iloc[-1] > hist["Close"].rolling(200).mean().iloc[-1]:
                score += 2
            return html.Div([
                html.P(f"{ticker.upper()} Current Price: ${last_price:.2f}"),
                html.P(f"{ticker.upper()} Score: {score}")
            ])
        except:
            return "Ticker not valid or no data available."
    return ""

@app.callback(
    Output("long-options-table", "data"),
    Output("long-options-table", "columns"),
    Output("short-options-table", "data"),
    Output("short-options-table", "columns"),
    Input("scanner-button", "n_clicks")
)
def run_scanner(n_clicks):
    if n_clicks == 0:
        return [], [], [], []
    
    MIN_DTE_LONG = 7
    MIN_DTE_SHORT = 1
    MAX_DTE = 45

    all_options_long = []
    all_options_short = []

    for ticker in tickers:
        try:
            opt = yf.Ticker(ticker)
            expirations = opt.options
            if not expirations:
                continue
            hist_file = f"{CACHE_DIR}/{ticker}.csv"
            if os.path.exists(hist_file):
                hist = pd.read_csv(hist_file, index_col=0, parse_dates=True)
            else:
                hist = opt.history(period="60d")
                hist.to_csv(hist_file)
            if hist.empty:
                continue
            current_price = hist["Close"].iloc[-1]
            high20 = hist["High"].rolling(20).max().iloc[-1]

            for exp in expirations:
                exp_date = datetime.datetime.strptime(exp, "%Y-%m-%d")
                dte = (exp_date - datetime.datetime.today()).days
                if dte < MIN_DTE_SHORT or dte > MAX_DTE:
                    continue
                chain = opt.option_chain(exp)
                for df_opt, typ in [(chain.calls, "CALL"), (chain.puts, "PUT")]:
                    for _, row in df_opt.iterrows():
                        try:
                            if pd.isna(row["lastPrice"]) or row["lastPrice"] == 0:
                                continue
                            score = 0
                            if row.get("volume", 0) > 2000:
                                score += 2
                            if row.get("openInterest", 0) > 5000:
                                score += 3
                            delta_val = abs(row.get("delta", 0.4))
                            if 0.35 <= delta_val <= 0.55:
                                score += 3
                            elif delta_val < 0.25:
                                score -= 2
                            if "impliedVolatility" in row and row["impliedVolatility"] > 0.5:
                                score += 2
                            if row["strike"] > high20:
                                score += 1
                            contract = {
                                "Ticker": ticker,
                                "Type": typ,
                                "Strike": row["strike"],
                                "Expiration": exp,
                                "LastPrice": row["lastPrice"],
                                "Volume": row.get("volume", 0),
                                "OpenInterest": row.get("openInterest", 0),
                                "Delta": delta_val,
                                "IV": row.get("impliedVolatility", 0),
                                "Score": score,
                                "DTE": dte
                            }
                            if dte >= MIN_DTE_LONG:
                                all_options_long.append(contract)
                            if dte >= MIN_DTE_SHORT:
                                all_options_short.append(contract)
                        except:
                            continue
            time.sleep(0.05)
        except:
            continue

    df_long = pd.DataFrame(all_options_long)
    df_short = pd.DataFrame(all_options_short)

    long_columns = [{"name": i, "id": i} for i in df_long.columns] if not df_long.empty else []
    short_columns = [{"name": i, "id": i} for i in df_short.columns] if not df_short.empty else []

    return df_long.to_dict("records"), long_columns, df_short.to_dict("records"), short_columns

@app.callback(
    Output("trending-table", "data"),
    Output("trending-table", "columns"),
    Input("trending-button", "n_clicks")
)
def trending_options(n_clicks):
    if n_clicks == 0:
        return [], []
    try:
        calls_url = "https://finance.yahoo.com/options/most-active?count=100"
        calls_tables = pd.read_html(calls_url)
        calls_df = calls_tables[0]
        calls_df = calls_df.rename(columns=lambda x: x.replace("\n", " "))
        calls_df = calls_df[["Symbol", "Last Price", "Volume", "Open Interest"]].head(20)
        calls_df["Type"] = "CALL"

        puts_url = "https://finance.yahoo.com/options/most-active?count=100&putCall=PUT"
        puts_tables = pd.read_html(puts_url)
        puts_df = puts_tables[0]
        puts_df = puts_df.rename(columns=lambda x: x.replace("\n", " "))
        puts_df = puts_df[["Symbol", "Last Price", "Volume", "Open Interest"]].head(20)
        puts_df["Type"] = "PUT"

        trending_df = pd.concat([calls_df, puts_df], ignore_index=True)
        columns = [{"name": i, "id": i} for i in trending_df.columns]
        return trending_df.to_dict("records"), columns
    except:
        return [], []

@app.callback(
    Output("portfolio-table", "data"),
    Output("portfolio-table", "columns"),
    Output("portfolio-capital", "children"),
    Input("portfolio-button", "n_clicks"),
    State("long-options-table", "data"),
    State("short-options-table", "data")
)
def portfolio_sim(n_clicks, long_data, short_data):
    if n_clicks == 0:
        return [], [], ""
    capital = 500
    allocation = []
    df_long = pd.DataFrame(long_data) if long_data else pd.DataFrame()
    df_short = pd.DataFrame(short_data) if short_data else pd.DataFrame()
    combined = pd.concat([df_long, df_short]).sort_values("Score", ascending=False) if not df_long.empty or not df_short.empty else pd.DataFrame()
    top_options = combined.head(5)
    for _, row in top_options.iterrows():
        contract_price = row["LastPrice"] * 100
        if row["Score"] >= 10:
            allocation_size = 0.4
        elif row["Score"] >= 7:
            allocation_size = 0.3
        else:
            allocation_size = 0.2
        max_alloc = capital * allocation_size
        if contract_price <= max_alloc:
            contracts = int(max_alloc // contract_price)
            if contracts > 0:
                total_cost = contracts * contract_price
                allocation.append({
                    "Ticker": row["Ticker"],
                    "Type": row["Type"],
                    "Strike": row["Strike"],
                    "Expiration": row["Expiration"],
                    "Contracts": contracts,
                    "Total Cost": round(total_cost, 2)
                })
                capital -= total_cost
    columns = [{"name": i, "id": i} for i in allocation[0].keys()] if allocation else []
    return allocation, columns, f"Remaining Capital: ${round(capital,2)}"

