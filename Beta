@app.callback(
    Output("snapshot-output", "children"),
    Input("save-snapshot-button", "n_clicks"),
    State("long-options-table", "data"),
    State("short-options-table", "data")
)
def save_snapshots(n_clicks, long_data, short_data):
    if n_clicks > 0:
        today = datetime.datetime.today().strftime("%Y%m%d")
        if long_data:
            pd.DataFrame(long_data).to_csv(f"options_snapshot_long_{today}.csv", index=False)
        if short_data:
            pd.DataFrame(short_data).to_csv(f"options_snapshot_short_{today}.csv", index=False)
        return "Snapshots saved successfully."
    return ""

